        "from crewai.tools import tool"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "jFRQrCDN3yqD"
      },
      "outputs": [],
      "source": [
        "llm = LLM(model=\"groq/llama-3.1-8b-instant\", api_key=os.getenv(\"GROQ_API_KEY\"), max_tokens=3000)\n",
        "#grow is having some issues so use hugginface or openai for this experiment"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "2HI8VLFDtPKy"
      },
      "outputs": [],
      "source": [
        "@tool\n",
        "def stock_news_searcher(query: str) -> str:\n",
        "    \"\"\"\n",
        "    Search for the latest news and updates about a stock using DuckDuckGo.\n",
        "\n",
        "    Args:\n",
        "        query: Search query for stock news (e.g., 'AAPL latest news', 'Tesla stock updates')\n",
        "    \"\"\"\n",
        "    with DDGS() as ddgsearch:\n",
        "        results = ddgsearch.text(query, max_results=2)  # Limit to 2 results to reduce output\n",
        "        return \"\\n\".join([r['body'] for r in results])\n",
        "\n",
        "@tool\n",
        "def yahoo_finance_tool(ticker: str) -> str:\n",
        "    \"\"\"\n",
        "    Get the latest 1-month stock price history for a given ticker using yFinance.\n",
        "\n",
        "    Args:\n",
        "        ticker: Stock ticker symbol (e.g., 'AAPL' for Apple Inc.)\n",
        "    \"\"\"\n",
        "    stock = yf.Ticker(ticker)\n",
        "    hist = stock.history(period=\"1mo\")\n",
        "    return hist.tail(10).to_string()  # Limit to last 10 rows for concise output"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "krV7Egr7tnHS"
      },
      "outputs": [],
      "source": [
        "stock_analyst = Agent(\n",
        "    role='Stock Analyst',\n",
        "    goal='Analyze the provided stock data and news',\n",
        "    backstory='Expert in financial trends, macro indicators, and company performance',\n",
        "    verbose=True,\n",
        "    allow_delegation=False,\n",
        "    llm=llm,\n",
        "    agentops_enabled=True, # Temporarily set to False to bypass the error\n",
        "    max_iter=5,\n",
        "    max_rpm=5,\n",
        "    max_execution_time=60,\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "w1h2o7Eh4isa"
      },
      "outputs": [],
      "source": [
        "report_writer = Agent(\n",
        "    role='Report Generator',\n",
        "    goal='Write investor-friendly summaries of stock analysis',\n",
        "    backstory='Professional writer with expertise in finance reporting',\n",
        "    verbose=True,\n",
        "    allow_delegation=False,\n",
        "    llm=llm,\n",
        "    agentops_enabled=True,  # Temporarily set to False to bypass the error\n",
        "    max_iter=5,              # Stop after 5 iterations\n",
        "    max_rpm=5,               # Never exceed 5 calls per minute\n",
        "    max_execution_time=60    # Stop after 60 seconds)\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "zjMLn1wT4v-P"
      },
      "outputs": [],
      "source": [
        "search_task = Task(\n",
        "    agent=stock_analyst,\n",
        "    tools=[stock_news_searcher],\n",
        "    description=\"\"\"Search the latest news and updates for the stock {stock}.\n",
        "                    Don't go into a loop, access the news available at the first hit.\"\"\",\n",
        "    expected_output=\"Summarized news highlights for the stock\",\n",
        ")\n",
        "analysis_task = Task(\n",
        "    description=\"\"\"for a given ticker: {ticker} fetch the data from yfinance and Analyze price trends.\n",
        "                    Don't go beyond 30 days in future to analyze price trend\n",
        "                    Use only this data for your analysis\"\"\",\n",
        "    expected_output=\"Key trends and technical highlights for the retrieved data.\",\n",
        "    agent=stock_analyst,\n",
        "    tools=[yahoo_finance_tool],\n",
        ")\n",
        "\n",
        "report_task = Task(\n",
        "    description=\"Write a clean investor report using previous analysis and news insights.\",\n",
        "    expected_output=\"Concise report with market summary and investment outlook.\",\n",
        "    agent=report_writer\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Wjz4ecso9VBT"
      },
      "outputs": [],
      "source": [
        "crew = Crew(\n",
        "    agents=[stock_analyst, report_writer],\n",
        "    tasks=[search_task, analysis_task, report_task],\n",
        "    verbose=False\n",
        "    )"
      ]
    },
    {
